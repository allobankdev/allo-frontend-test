{
  "extends": "@vue/tsconfig/tsconfig.dom.json",
  // "typed-router.d.ts" and "components.d.ts" are generated by the Vite plugins.
  // Including them lets vue-tsc know the typed routes and auto-imported components.
  "include": ["env.d.ts", "typed-router.d.ts", "components.d.ts", "src/**/*", "src/**/*.vue"],
  "exclude": ["src/**/__tests__/*"],
  "compilerOptions": {
    "composite": true,
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.app.tsbuildinfo",

    "baseUrl": ".",
    "paths": {
      "@/*": ["./src/*"]
    }
  }
}
