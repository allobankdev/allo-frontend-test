{
  // Note: intentionally not extending @tsconfig/node22, whose `lib: ["es2024"]` is not
  // recognized by the pinned TypeScript 5.6.3 (validated at parse time before any
  // override can apply). The equivalent options are inlined below. This project only
  // type-checks the Vite/Vitest config files.
  "include": [
    "vite.config.*",
    "vitest.config.*",
    "cypress.config.*",
    "nightwatch.conf.*",
    "playwright.config.*"
  ],
  "compilerOptions": {
    "composite": true,
    "noEmit": true,
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.node.tsbuildinfo",

    "target": "ESNext",
    "lib": ["ESNext"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "types": ["node"]
  }
}
